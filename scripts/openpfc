#!/bin/sh
# SPDX-FileCopyrightText: 2026 VTT Technical Research Centre of Finland Ltd
# SPDX-License-Identifier: AGPL-3.0-or-later
# Source-checkout convenience launcher. All behavior is in the native executable.
set -eu
cli_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cli_binary=${OPENPFC_CLI:-"$cli_root/builds/release/bin/openpfc"}
if [ ! -x "$cli_binary" ]; then
  echo "Build the native CLI with scripts/build.sh first, or set OPENPFC_CLI to its bin/openpfc." >&2
  exit 2
fi
exec "$cli_binary" "$@"
