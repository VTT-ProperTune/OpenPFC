include_guard(GLOBAL)

# Shared provider/consumer probe. Never trust a cached result from another stack.
function(_openpfc_sdk_probe out status configuration link_target)
  if(CMAKE_CROSSCOMPILING)
    set(${out} "{}" PARENT_SCOPE)
    set(${status} "unknown: cross-compiling; run the installed probe on the target" PARENT_SCOPE)
    return()
  endif()
  set(CMAKE_TRY_COMPILE_CONFIGURATION "${configuration}")
  unset(_openpfc_probe_run CACHE)
  unset(_openpfc_probe_built CACHE)
  set(_definitions)
  if(link_target STREQUAL "OpenPFC::openpfc")
    list(APPEND _definitions -DOPENPFC_SDK_LINK_PROBE)
  endif()
  try_run(_openpfc_probe_run _openpfc_probe_built
    "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/openpfc-sdk-probe/${configuration}"
    "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/openpfc_sdk_probe.cpp"
    CMAKE_FLAGS "-DCMAKE_CXX_STANDARD=20" "-DCMAKE_CXX_STANDARD_REQUIRED=ON"
      "-DCMAKE_BUILD_TYPE=${configuration}"
    COMPILE_DEFINITIONS ${_definitions}
    LINK_LIBRARIES ${link_target}
    COMPILE_OUTPUT_VARIABLE _compile_output
    RUN_OUTPUT_VARIABLE _output)
  string(JSON _type ERROR_VARIABLE _error TYPE "${_output}")
  if(_openpfc_probe_built AND "${_openpfc_probe_run}" STREQUAL "0" AND NOT _error)
    set(${out} "${_output}" PARENT_SCOPE)
    set(${status} "compiled-linked-ran" PARENT_SCOPE)
  else()
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/openpfc-sdk-probe.log"
      "${_compile_output}\n${_output}\nrun result: ${_openpfc_probe_run}\n")
    set(${out} "{}" PARENT_SCOPE)
    set(${status} "unknown: probe failed; see CMakeFiles/openpfc-sdk-probe.log" PARENT_SCOPE)
  endif()
endfunction()

# openpfc_check_compatibility(RESULT result REPORT report [REQUIRED]
#   [CONFIGURATION config] [BACKEND CPU|CUDA|HIP] [GPU_ARCHITECTURE arch]
#   [MANIFEST path])
# Result is compatible, incompatible or unverified. REQUIRED rejects both latter
# states. This checks the host ABI and MPI evidence; it never certifies GPU MPI.
function(openpfc_check_compatibility)
  cmake_parse_arguments(PARSE_ARGV 0 arg "REQUIRED"
    "RESULT;REPORT;CONFIGURATION;BACKEND;GPU_ARCHITECTURE;MANIFEST" "")
  if(arg_UNPARSED_ARGUMENTS OR arg_KEYWORDS_MISSING_VALUES OR NOT arg_RESULT OR NOT arg_REPORT)
    message(FATAL_ERROR "openpfc_check_compatibility requires RESULT and REPORT; unknown arguments: ${arg_UNPARSED_ARGUMENTS}")
  endif()
  if(NOT arg_MANIFEST)
    set(arg_MANIFEST "${OpenPFC_BUILD_MANIFEST}")
  endif()
  if(NOT EXISTS "${arg_MANIFEST}")
    message(FATAL_ERROR "OpenPFC SDK manifest missing: ${arg_MANIFEST}. Select a complete preinstalled SDK with OpenPFC_DIR or CMAKE_PREFIX_PATH.")
  endif()
  file(READ "${arg_MANIFEST}" _manifest)
  string(JSON _schema ERROR_VARIABLE _error GET "${_manifest}" schema_version)
  if(_error OR NOT _schema STREQUAL "1")
    message(FATAL_ERROR "Unsupported OpenPFC SDK manifest schema in ${arg_MANIFEST}")
  endif()
  if(NOT arg_CONFIGURATION)
    if(CMAKE_TRY_COMPILE_CONFIGURATION)
      set(arg_CONFIGURATION "${CMAKE_TRY_COMPILE_CONFIGURATION}")
    elseif(CMAKE_BUILD_TYPE)
      set(arg_CONFIGURATION "${CMAKE_BUILD_TYPE}")
    else()
      string(JSON arg_CONFIGURATION GET "${_manifest}" configuration)
    endif()
  endif()
  set(_bad)
  set(_unknown)
  if(NOT arg_BACKEND)
    set(arg_BACKEND CPU)
  endif()
  if(NOT arg_BACKEND MATCHES "^(CPU|CUDA|HIP)$")
    message(FATAL_ERROR "OpenPFC BACKEND must be CPU, CUDA or HIP")
  endif()
  string(TOLOWER "${arg_BACKEND}" _backend)
  string(JSON _enabled GET "${_manifest}" capabilities "${_backend}")
  if(NOT _enabled)
    list(APPEND _bad "requested ${arg_BACKEND} backend is absent from this SDK")
  endif()
  if(NOT arg_BACKEND STREQUAL CPU)
    string(JSON _architectures GET "${_manifest}" toolchains "${arg_BACKEND}" architectures)
    if(arg_GPU_ARCHITECTURE AND NOT arg_GPU_ARCHITECTURE IN_LIST _architectures)
      list(APPEND _unknown "GPU architecture ${arg_GPU_ARCHITECTURE} is not an exact recorded target (${_architectures}); check virtual ISA/runtime device support")
    endif()
    list(APPEND _unknown "${arg_BACKEND} host/device compiler and runtime compatibility requires a device compile/link/run probe with the selected toolkit")
  endif()
  _openpfc_sdk_probe(_consumer _probe_status "${arg_CONFIGURATION}" OpenPFC::openpfc)
  string(JSON _provider_status GET "${_manifest}" probe_status)
  if(NOT _probe_status STREQUAL "compiled-linked-ran" OR
      NOT _provider_status STREQUAL "compiled-linked-ran")
    list(APPEND _unknown "provider probe: ${_provider_status}, consumer probe: ${_probe_status}")
  else()
    foreach(_field stdlib stdlib_abi stdlib_debug pointer_size mpi_vendor)
      string(JSON _sdk GET "${_manifest}" host_probe "${_field}")
      string(JSON _app GET "${_consumer}" "${_field}")
      if(_sdk STREQUAL "unknown" OR _app STREQUAL "unknown")
        list(APPEND _unknown "${_field}: SDK=${_sdk}, consumer=${_app}")
      elseif(NOT _sdk STREQUAL _app)
        list(APPEND _bad "${_field}: SDK=${_sdk}, consumer=${_app}")
      endif()
    endforeach()
    foreach(_field mpi_header_version mpi_library_version)
      string(JSON _sdk GET "${_manifest}" host_probe "${_field}")
      string(JSON _app GET "${_consumer}" "${_field}")
      if(_sdk STREQUAL "unknown" OR NOT _sdk STREQUAL _app)
        list(APPEND _unknown "${_field} differs or is unknown: SDK=${_sdk}, consumer=${_app}; MPI ABI needs a site-supported interoperability probe")
      endif()
    endforeach()
    # Matching version labels alone cannot establish MPI library compatibility.
    _openpfc_mpi_library_evidence(_consumer_libraries)
    string(JSON _sdk_libraries GET "${_manifest}" mpi libraries)
    set(_unresolved FALSE)
    foreach(_side sdk consumer)
      set(_${_side}_hashes)
      string(JSON _count LENGTH "${_${_side}_libraries}")
      if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE 0 ${_last})
          string(JSON _hash GET "${_${_side}_libraries}" ${_index} sha256)
          if(_hash STREQUAL "unknown")
            set(_unresolved TRUE)
          endif()
          list(APPEND _${_side}_hashes "${_hash}")
        endforeach()
        list(REMOVE_DUPLICATES _${_side}_hashes)
        list(SORT _${_side}_hashes)
      endif()
    endforeach()
    if(_unresolved OR NOT _sdk_hashes OR NOT _sdk_hashes STREQUAL _consumer_hashes)
      list(APPEND _unknown "resolved MPI library files differ or are unavailable; equal version/SONAME labels do not verify MPI ABI compatibility")
    endif()
    string(JSON _sdk GET "${_manifest}" host_probe stdlib_version)
    string(JSON _app GET "${_consumer}" stdlib_version)
    if(NOT _sdk STREQUAL _app)
      list(APPEND _unknown "C++ runtime header version differs: SDK=${_sdk}, consumer=${_app}; verify required runtime symbols")
    endif()
    string(JSON _sdk GET "${_manifest}" toolchains CXX CMAKE_CXX_COMPILER_ID)
    # GCC and Clang can interoperate using the Itanium ABI and libstdc++.
    if(NOT _sdk STREQUAL CMAKE_CXX_COMPILER_ID AND
        NOT (_sdk MATCHES "^(GNU|Clang|AppleClang)$" AND
             CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$"))
      list(APPEND _unknown "compiler ABI family differs: SDK=${_sdk}, consumer=${CMAKE_CXX_COMPILER_ID}")
    endif()
  endif()
  if(_bad)
    set(_result incompatible)
  elseif(_unknown)
    set(_result unverified)
  else()
    set(_result compatible)
  endif()
  set(_report "OpenPFC SDK ${_result} (host compile/link/run and static evidence only; GPU-aware MPI runtime unverified)")
  foreach(_reason IN LISTS _bad _unknown)
    string(APPEND _report "\n  ${_reason}")
  endforeach()
  set(${arg_RESULT} "${_result}" PARENT_SCOPE)
  set(${arg_REPORT} "${_report}" PARENT_SCOPE)
  if(arg_REQUIRED AND NOT _result STREQUAL compatible)
    message(FATAL_ERROR "${_report}\nSelect a compatible preinstalled OpenPFC SDK using OpenPFC_DIR/CMAKE_PREFIX_PATH, or resolve the reported unknowns with explicit runtime probes.")
  endif()
endfunction()

# File hashes identify concrete libraries, never an MPI ABI. Paths are diagnostic.
function(_openpfc_mpi_library_evidence out)
  set(_libraries ${MPI_CXX_LIBRARIES})
  if(TARGET MPI::MPI_CXX)
    get_target_property(_links MPI::MPI_CXX INTERFACE_LINK_LIBRARIES)
    list(APPEND _libraries ${_links})
  endif()
  list(REMOVE_DUPLICATES _libraries)
  set(_evidence "[]")
  foreach(_library IN LISTS _libraries)
    if(NOT IS_ABSOLUTE "${_library}" OR NOT EXISTS "${_library}")
      set(_entry "{\"sha256\":\"unknown\",\"soname\":\"unknown\"}")
      _openpfc_json_field(_entry unresolved_link_item "${_library}")
      string(JSON _length LENGTH "${_evidence}")
      string(JSON _evidence SET "${_evidence}" ${_length} "${_entry}")
      continue()
    endif()
    file(REAL_PATH "${_library}" _resolved)
    file(SHA256 "${_resolved}" _sha)
    set(_entry "{}")
    _openpfc_json_field(_entry path "${_library}")
    _openpfc_json_field(_entry resolved_path "${_resolved}")
    _openpfc_json_field(_entry sha256 "${_sha}")
    set(_soname unknown)
    if(CMAKE_READELF)
      execute_process(COMMAND "${CMAKE_READELF}" -d "${_resolved}"
        OUTPUT_VARIABLE _dynamic ERROR_QUIET RESULT_VARIABLE _result)
      if(_result EQUAL 0 AND _dynamic MATCHES "\\(SONAME\\)[^\n]*\\[([^]]+)\\]")
        set(_soname "${CMAKE_MATCH_1}")
      endif()
    endif()
    _openpfc_json_field(_entry soname "${_soname}")
    string(JSON _length LENGTH "${_evidence}")
    string(JSON _evidence SET "${_evidence}" ${_length} "${_entry}")
  endforeach()
  set(${out} "${_evidence}" PARENT_SCOPE)
endfunction()

function(_openpfc_json_field object key value)
  string(TOUPPER "${value}" _upper_value)
  if(_upper_value MATCHES "[A-Z0-9_]*(TOKEN|PASSWORD|SECRET|CREDENTIAL|API_KEY|ACCESS_KEY|AUTHORIZATION)[A-Z0-9_]*[=:]" OR
      value MATCHES "://[^ /;]*@")
    set(value "unknown: credential-like diagnostic redacted")
  endif()
  string(REPLACE "\\" "\\\\" _value "${value}")
  string(REPLACE "\"" "\\\"" _value "${_value}")
  string(REPLACE "\n" "\\n" _value "${_value}")
  string(REPLACE "\r" "\\r" _value "${_value}")
  string(REPLACE "\t" "\\t" _value "${_value}")
  string(JSON _json SET "${${object}}" "${key}" "\"${_value}\"")
  set(${object} "${_json}" PARENT_SCOPE)
endfunction()
