  "book": [
    {
      "program": 1,
      "title": "convergence of fourth-order finite differences",
      "source": "https://people.maths.ox.ac.uk/trefethen/p1.m",
      "chapter": "differentiation/periodic/index.qmd",
      "scope": "Original fourth-order finite-difference resolution family, with additional FD2 and FFT comparisons."
    },
    {
      "program": 2,
      "title": "convergence of periodic spectral method (compare p1.m)",
      "source": "https://people.maths.ox.ac.uk/trefethen/p2.m",
      "chapter": "differentiation/smoothness/index.qmd",
      "scope": "Original even 2..100 collocation matrix sweep; FFT comparison added."
    },
    {
      "program": 3,
      "title": "band-limited interpolation",
      "source": "https://people.maths.ox.ac.uk/trefethen/p3.m",
      "chapter": "interpolation/cardinal/index.qmd",
      "scope": "All three original sampled profiles and sinc reconstructions; exact nodal limits handled."
    },
    {
      "program": 4,
      "title": "periodic spectral differentiation",
      "source": "https://people.maths.ox.ac.uk/trefethen/p4.m",
      "chapter": "differentiation/collocation/index.qmd",
      "scope": "Original periodic cotangent differentiation of hat and analytic profiles."
    },
    {
      "program": 5,
      "title": "repetition of p4.m via FFT",
      "source": "https://people.maths.ox.ac.uk/trefethen/p5.m",
      "chapter": "differentiation/collocation/index.qmd",
      "scope": "FFT version of both program 4 profiles, compared against the matrix action."
    },
    {
      "program": 6,
      "title": "variable coefficient wave equation",
      "source": "https://people.maths.ox.ac.uk/trefethen/p6.m",
      "chapter": "waves/variable-transport/index.qmd",
      "scope": "Original variable-speed Gaussian experiment and book startup preset, with a consistent Taylor startup and characteristic reference added."
    },
    {
      "program": 7,
      "title": "accuracy of periodic spectral differentiation",
      "source": "https://people.maths.ox.ac.uk/trefethen/p7.m",
      "chapter": "differentiation/smoothness/index.qmd",
      "scope": "All four original regularity profiles on even 6..50 grids, with matrix and FFT errors."
    },
    {
      "program": 8,
      "title": "eigenvalues of harmonic oscillator -u\"+x^2 u on R",
      "source": "https://people.maths.ox.ac.uk/trefethen/p8.m",
      "chapter": "fourier/harmonic-oscillator/index.qmd",
      "scope": "Original L=8 and N=6:6:36 harmonic oscillator, with kinetic matrix built using native LocalFFT."
    },
    {
      "program": 9,
      "title": "polynomial interpolation in equispaced and Chebyshev pts",
      "source": "https://people.maths.ox.ac.uk/trefethen/p9.m",
      "chapter": "polynomials/interpolation/index.qmd",
      "scope": "Original degree-16 node comparison, using barycentric evaluation instead of monomial fitting."
    },
    {
      "program": 10,
      "title": "polynomials and corresponding equipotential curves",
      "source": "https://people.maths.ox.ac.uk/trefethen/p10.m",
      "chapter": "polynomials/nodal-polynomials/index.qmd",
      "scope": "Original signed nodal products and complex-plane magnitude contours, evaluated directly from their roots."
    },
    {
      "program": 11,
      "title": "Chebyshev differentation of a smooth function",
      "source": "https://people.maths.ox.ac.uk/trefethen/p11.m",
      "chapter": "polynomials/differentiation/index.qmd",
      "scope": "Original smooth profile at degrees 10 and 20, differentiated with the Chebyshev collocation matrix."
    },
    {
      "program": 12,
      "title": "accuracy of Chebyshev spectral differentiation",
      "source": "https://people.maths.ox.ac.uk/trefethen/p12.m",
      "chapter": "polynomials/regularity/index.qmd",
      "scope": "All four original profiles and degrees 1..50, with limiting bump values handled explicitly."
    },
    {
      "program": 13,
      "title": "solve linear BVP u_xx = exp(4x), u(-1)=u(1)=0",
      "source": "https://people.maths.ox.ac.uk/trefethen/p13.m",
      "chapter": "polynomials/boundary-values/index.qmd",
      "scope": "Original degree-16 homogeneous Dirichlet collocation problem, solved with native GMRES."
    },
    {
      "program": 14,
      "title": "solve nonlinear BVP u_xx = exp(u), u(-1)=u(1)=0",
      "source": "https://people.maths.ox.ac.uk/trefethen/p14.m",
      "chapter": "polynomials/nonlinear-boundary/index.qmd",
      "scope": "Original nonlinear collocation problem, using native Newton–GMRES instead of fixed-point iteration and an analytic reference."
    },
    {
      "program": 15,
      "title": "solve eigenvalue BVP u_xx = lambda*u, u(-1)=u(1)=0",
      "source": "https://people.maths.ox.ac.uk/trefethen/p15.m",
      "chapter": "polynomials/eigenmodes/index.qmd",
      "scope": "Original degree-36 Dirichlet spectrum and six selected modes, using an example-owned complex QR eigensolver."
    },
    {
      "program": 16,
      "title": "Poisson eq. on [-1,1]x[-1,1] with u=0 on boundary",
      "source": "https://people.maths.ox.ac.uk/trefethen/p16.m",
      "chapter": null,
      "scope": "Original degree-24 Chebyshev Poisson problem; native GMRES applies the tensor operator without forming a Kronecker matrix."
    },
    {
      "program": 17,
      "title": "Helmholtz eq. u_xx + u_yy + (k^2)u = f",
      "source": "https://people.maths.ox.ac.uk/trefethen/p17.m",
      "chapter": null,
      "scope": "Original k=9 degree-24 Helmholtz problem with a native tensor-action GMRES solve."
    },
    {
      "program": 18,
      "title": "Chebyshev differentiation via FFT (compare p11.m)",
      "source": "https://people.maths.ox.ac.uk/trefethen/p18.m",
      "chapter": "polynomials/differentiation/index.qmd",
      "scope": "Same polynomial derivative via native LocalFFT cosine coefficients, with explicit O(N²) coefficient-sum evaluation and endpoint limits."
    },
    {
      "program": 19,
      "title": "2nd-order wave eq. on Chebyshev grid (compare p6.m)",
      "source": "https://people.maths.ox.ac.uk/trefethen/p19.m",
      "chapter": null,
      "scope": "FFT-based Chebyshev wave with the original N=80 Gaussian, leapfrog startup and rounded save schedule; direct chain-rule second derivatives replace two successive chebfft calls. Taylor startup and an exact standing mode are additional checks."
    },
    {
      "program": 20,
      "title": "2nd-order wave eq. in 2D via FFT (compare p19.m)",
      "source": "https://people.maths.ox.ac.uk/trefethen/p20.m",
      "chapter": null,
      "scope": "Original N=24 Chebyshev square, Gaussian and leapfrog startup. Native LocalFFT evaluates both tensor derivatives; initial Gaussian boundary tails are retained. Nodal plots replace cubic display interpolation; Taylor startup exposes the initial-velocity error."
    },
    {
      "program": 21,
