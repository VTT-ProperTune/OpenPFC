function(call expected)
  execute_process(COMMAND "${cli}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT code EQUAL expected)
    message(FATAL_ERROR "CLI returned ${code}, expected ${expected}: ${out}\n${err}")
  endif()
  set(output "${out}" PARENT_SCOPE)
  set(error "${err}" PARENT_SCOPE)
endfunction()
string(RANDOM LENGTH 12 id)
set(root "${build}/cli-cases-${id}")
file(MAKE_DIRECTORY "${root}")
call(0 init "${root}/nested/parent/new case")
call(0 --version)
if(NOT output MATCHES "OpenPFC [0-9]+\\.[0-9]+\\.[0-9]+")
  message(FATAL_ERROR "Invalid CLI version: ${output}")
endif()
foreach(command apps init compile run export doctor bundle)
  call(0 "${command}" --help)
  if(NOT output MATCHES "Usage: openpfc ${command}")
    message(FATAL_ERROR "Missing command help: ${output}")
  endif()
  set(long_help "${output}")
  call(0 help "${command}")
  if(NOT output STREQUAL long_help)
    message(FATAL_ERROR "Help entry points disagree for ${command}")
  endif()
endforeach()
call(0 compile --help)
if(NOT output MATCHES "--sdk" OR NOT output MATCHES "--source-root")
  message(FATAL_ERROR "Source build options are not discoverable")
endif()
call(0 run -h)
if(NOT output MATCHES "--input-file" OR NOT output MATCHES "--launcher")
  message(FATAL_ERROR "Source run options are not discoverable")
endif()
call(0 bundle --help)
if(NOT output MATCHES "--prepare-only" OR NOT output MATCHES "--base" OR
   NOT output MATCHES "scratch" OR NOT output MATCHES "not qualified" OR
   NOT output MATCHES "bake_case.py")
  message(FATAL_ERROR "Bundle help is incomplete: ${output}")
endif()
call(2 help unknown-command)
call(2 help compile run)
call(2 unknown-command --help)
call(2 doctor extra-argument)
call(2 doctor --backend=hip)
set(model "${root}/editable model with spaces ü")
call(0 init "${model}" --model=diffusion)
foreach(name model.cpp input.json README.md input.json.license)
  if(NOT EXISTS "${model}/${name}")
    message(FATAL_ERROR "Starter file missing: ${name}")
  endif()
endforeach()
file(APPEND "${model}/model.cpp" "\n// user edits\n")
file(SHA256 "${model}/model.cpp" before)
call(2 init "${model}" --model=diffusion)
file(SHA256 "${model}/model.cpp" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Starter init overwrote user code")
endif()
call(2 init "${root}/bad model" --model=unknown)
call(2 init "${root}/bad model" --model=diffusion --app=tungsten)
call(2 init "${root}/bad model" --model=diffusion --preset=smoke)
if(EXISTS "${root}/bad model")
  message(FATAL_ERROR "Invalid starter options created a directory")
endif()
call(0 apps)
foreach(app tungsten aluminum cahn_hilliard thin_film surface_diffusion kawahara ehd_film gradient_elasticity higher_order_pfc)
  if(NOT output MATCHES "${app}")
    message(FATAL_ERROR "Missing catalog app ${app}")
  endif()
endforeach()
foreach(pair "tungsten;smoke" "aluminum;smoke" "cahn_hilliard;spinodal" "cahn_hilliard;mode"
    "thin_film;leveling" "thin_film;dewetting" "surface_diffusion;smoothing" "kawahara;pulse"
    "ehd_film;relaxation" "gradient_elasticity;inclusion" "gradient_elasticity;gaussian"
    "higher_order_pfc;two_mode" "higher_order_pfc;single_mode")
  list(GET pair 0 app)
  list(GET pair 1 preset)
  set(case "${root}/${app}-${preset} with spaces ü")
  call(0 init "${case}" "--app=${app}" "--preset=${preset}")
  file(READ "${case}/openpfc.json" manifest)
  string(JSON value GET "${manifest}" app)
  if(NOT value STREQUAL app)
    message(FATAL_ERROR "Invalid app manifest")
  endif()
  file(SHA256 "${case}/input.json" before)
  call(2 init "${case}")
  file(SHA256 "${case}/input.json" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "init overwrote existing input")
  endif()
endforeach()
set(case "${root}/tungsten-smoke with spaces ü")
call(2 run "${case}" --ranks=0)
call(2 run "${case}" --executable=/does/not/exist)
call(0 run "${case}" --executable=/bin/true --dry-run --ranks=2 --launcher=mpirun)
if(NOT output MATCHES "mpirun" OR NOT output MATCHES "\"2\"")
  message(FATAL_ERROR "Incorrect launcher arguments: ${output}")
endif()
foreach(rank OMPI_COMM_WORLD_RANK PMI_RANK PMIX_RANK SLURM_PROCID)
  set(ENV{${rank}} 0)
  call(0 run "${case}" --executable=/bin/true --dry-run)
  if(output MATCHES "mpirun|srun")
    message(FATAL_ERROR "Nested MPI launcher: ${output}")
  endif()
  call(2 run "${case}" --executable=/bin/true --ranks=2)
  unset(ENV{${rank}})
endforeach()
set(fake "${root}/fake app")
file(WRITE "${fake}" "#!/bin/sh\npwd > cwd.txt\nprintf '%s\\n' \"$@\" > argv.txt\nexit 19\n")
file(CHMOD "${fake}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
call(19 run "${case}" --launcher=none --executable "${fake}")
file(READ "${case}/cwd.txt" cwd)
string(STRIP "${cwd}" cwd)
if(NOT cwd STREQUAL case)
  message(FATAL_ERROR "Incorrect case working directory: ${cwd}")
endif()
file(MAKE_DIRECTORY "${root}/source/scripts")
foreach(profile local tohtori lumi)
  if(profile STREQUAL local)
    set(binary tungsten)
    set(flag --cpu)
  elseif(profile STREQUAL tohtori)
    set(binary tungsten_cuda)
    set(flag --with-cuda)
  else()
    set(binary tungsten_hip)
    set(flag --with-rocm)
  endif()
  file(WRITE "${root}/source/scripts/build.sh"
    "printf '%s\\n' \"$@\" > arguments.txt\nfor arg in \"$@\"; do\ncase \"$arg\" in --build-dir=*) cli_build=\"\${arg#*=}\";; esac\ndone\nmkdir -p \"$cli_build/apps/tungsten\"\ncp /bin/true \"$cli_build/apps/tungsten/${binary}\"\n")
  call(0 compile "${case}" "--profile=${profile}" --source "${root}/source"
    --build-dir "${root}/case-build" --jobs=2)
  file(READ "${root}/source/arguments.txt" arguments)
  if(NOT arguments MATCHES "${flag}" OR NOT arguments MATCHES "--test")
    message(FATAL_ERROR "Incorrect build profile: ${arguments}")
  endif()
endforeach()
file(SHA256 "${case}/openpfc.json" before)
file(WRITE "${root}/source/scripts/build.sh" "exit 17\n")
call(17 compile "${case}" --source "${root}/source" --build-dir "${root}/case-build")
file(SHA256 "${case}/openpfc.json" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Failed compile changed the case selection")
endif()
call(0 compile "${case}" --source "${root}/source" --dry-run)
call(2 compile "${root}/cahn_hilliard-spinodal with spaces ü" --profile=tohtori --source "${root}/source" --dry-run)
call(2 init "${root}/invalid" --app=does-not-exist)
call(2 init "${root}/invalid" --preset=does-not-exist)
call(2 apps --unknown=value)
call(2 --unknown=value)
