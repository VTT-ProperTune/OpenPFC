function(call)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "CLI app smoke failed (${code}): ${out}\n${err}")
  endif()
endfunction()
string(RANDOM LENGTH 12 id)
set(case "${build}/cli-smoke-${app}-${id}")
call("${cli}" --version)
call("${cli}" init "${case}" "--app=${app}")
if(NOT app STREQUAL tungsten)
  file(READ "${case}/input.json" input)
  foreach(pair "t1;0.02" "dt;0.01" "saveat;0.01")
    list(GET pair 0 key)
    list(GET pair 1 value)
    string(JSON input SET "${input}" timestepping "${key}" "${value}")
  endforeach()
  file(WRITE "${case}/input.json" "${input}\n")
endif()
call("${cli}" run "${case}" --launcher=none --executable "${binary}")
file(GLOB_RECURSE outputs "${case}/results/*.vti")
list(LENGTH outputs count)
if(NOT count EQUAL 3)
  message(FATAL_ERROR "Expected three VTK outputs, got ${count}")
endif()
if(app STREQUAL tungsten)
  file(READ "${case}/results/checkpoints/step_10/metadata.json" metadata)
  string(JSON increment GET "${metadata}" accepted_increment)
  string(JSON counter GET "${metadata}" result_counter)
  if(NOT increment EQUAL 10 OR NOT counter EQUAL 3)
    message(FATAL_ERROR "Invalid checkpoint from CLI scaffold")
  endif()
endif()
