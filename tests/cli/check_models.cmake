list(GET summaries 0 serial_summary)
file(READ "${serial_summary}" serial_result)
string(JSON mean GET "${serial_result}" mean)
string(JSON initial GET "${serial_result}" initial_l2)
string(JSON final GET "${serial_result}" final_l2)
# Discrete Fourier mode: sqrt(1 + 0.1^2/2 * (1 - 0.4*sin(pi/16)^2)^20).
if(mean LESS 0.999999999 OR mean GREATER 1.000000001 OR NOT final LESS initial OR
   final LESS 1.0018377625 OR final GREATER 1.0018377628)
  message(FATAL_ERROR "Starter failed mass conservation or diffusion: ${serial_result}")
endif()
get_filename_component(serial_results "${serial_summary}" DIRECTORY)
