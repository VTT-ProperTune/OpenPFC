string(JSON provider_count LENGTH "${bundle_provenance}" host_provider_directories)
if(provider_count GREATER 0)
  math(EXPR provider_last "${provider_count} - 1")
  foreach(provider_index RANGE ${provider_last})
    string(JSON provider_dir GET "${bundle_provenance}" host_provider_directories
           ${provider_index})
    string(FIND "${bundle_helper}" "${provider_dir}:${provider_dir}:ro" provider_at)
    if(provider_at LESS 0)
      message(FATAL_ERROR "Provider directory is not bind-mounted: ${provider_dir}")
    endif()
  endforeach()
endif()
file(GLOB_RECURSE bundle_payload "${bundle_dir}/payload/*")
foreach(payload_file IN LISTS bundle_payload)
  if(payload_file MATCHES "\\.(py|hpp|h)$")
    message(FATAL_ERROR "Payload contains source or Python: ${payload_file}")
  endif()
endforeach()
file(SHA256 "${bundle_dir}/payload/provenance.json" provenance_before)
execute_process(
  COMMAND "${cli}" bundle "${project}/mpi.cpp" --prepare-only --output "${bundle_image}"
    --base "${bundle_base}" --site=openmpi ${host_args} ${common}
  RESULT_VARIABLE bundle_code OUTPUT_VARIABLE bundle_output ERROR_VARIABLE bundle_error)
if(NOT bundle_code EQUAL 0)
  message(FATAL_ERROR "Repeated prepare-only failed: ${bundle_error}")
endif()
file(SHA256 "${bundle_dir}/payload/provenance.json" provenance_after)
if(NOT provenance_before STREQUAL provenance_after)
  message(FATAL_ERROR "Repeated prepare-only rewrote provenance")
endif()
