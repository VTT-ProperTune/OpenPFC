#
# HeFFTe 2.4.1 with the ROCm (rocFFT) and FFTW backends for LUMI-G, cpeGNU.
# Mirrors scripts/build_heffte_rocm.sh. LUMI-EasyBuild-contrib ships a cpeAMD
# variant only; OpenPFC builds with cpeGNU, and both must share one toolchain.
#
# This variant applies the FFTW real-transform planning correction
# (HeFFTe-2.4.1_fftw-real-plans.patch, the same change as OpenPFC's
# cmake/patches/heffte-2.4.1-fftw-plans.patch). Unpatched 2.4.1 plans r2c and
# c2r in place and executes them out of place, which can crash or return wrong
# float and strided real transforms. The suffix keeps the unpatched module that
# OpenPFC 0.5.0 uses unchanged.

easyblock = 'CMakeMake'

name =          'HeFFTe'
version =       '2.4.1'
versionsuffix = '-rocm-planfix'

homepage = 'https://icl.utk.edu/fft'

whatis = [
    'Description: Highly Efficient FFT for Exascale (HeFFTe), ROCm + FFTW backends for cpeGNU',
]

description = """
HeFFTe provides distributed multidimensional FFTs. This build enables the
rocFFT backend for MI250X (gfx90a) next to FFTW from cray-fftw, with
GPU-aware Cray MPICH. It is intended for the ROCm OpenPFC module.
"""

toolchain = {'name': 'cpeGNU', 'version': '25.09'}
toolchainopts = {'usempi': True, 'openmp': True}

sources = {
    'download_filename': 'v%(version)s.tar.gz',
    'filename':          SOURCELOWER_TAR_GZ,
    'source_urls':       ['https://github.com/icl-utk-edu/heffte/archive/refs/tags/'],
}
patches = ['HeFFTe-%(version)s_fftw-real-plans.patch']
checksums = [
    'de2cf26df5d61baac7841525db3f393cb007f79612ac7534fd4757f154ba3e6c',  # heffte-2.4.1.tar.gz
    '9b52b95704419c496a6ecc442b05f023319e2dd65928e3c2a2cc0369ba8a8af1',  # HeFFTe-2.4.1_fftw-real-plans.patch
]

builddependencies = [
    ('buildtools', '%(toolchain_version)s', '', True),
]

dependencies = [
    ('cray-fftw', EXTERNAL_MODULE),
    ('rocm',      EXTERNAL_MODULE),
]

build_shared_libs = True

# hipcc compiles HeFFTe's .hip sources without the Cray wrapper, so the
# MPICH headers are passed explicitly; MPICH_DIR is set by cray-mpich.
configopts  = '-D CMAKE_BUILD_TYPE=Release '
configopts += '-D CMAKE_C_COMPILER=cc '
configopts += '-D CMAKE_CXX_COMPILER=CC '
configopts += '-D MPI_CXX_COMPILER=CC '
configopts += '-D Heffte_ENABLE_FFTW=ON '
configopts += '-D Heffte_ENABLE_ROCM=ON '
configopts += '-D Heffte_ENABLE_CUDA=OFF '
configopts += '-D Heffte_ENABLE_GPU_AWARE_MPI=ON '
configopts += '-D CMAKE_HIP_ARCHITECTURES=gfx90a '
configopts += '-D CMAKE_HIP_FLAGS="-I$MPICH_DIR/include" '

sanity_check_paths = {
    'files': ['lib/libheffte.%s' % SHLIB_EXT],
    'dirs':  ['include', 'lib/cmake/Heffte'],
}

moduleclass = 'lib'
