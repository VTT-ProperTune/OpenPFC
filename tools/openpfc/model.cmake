cmake_minimum_required(VERSION 3.21)
project(OpenPFCUserModel LANGUAGES C CXX)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
find_package(OpenPFC 0.5 CONFIG REQUIRED)
if(NOT COMMAND openpfc_check_compatibility)
  message(FATAL_ERROR "The selected installed OpenPFC SDK lacks compatibility metadata; select a current SDK with OpenPFC_DIR")
endif()
if(OPENPFC_DOCTOR)
  openpfc_check_compatibility(RESULT sdk_status REPORT sdk_report BACKEND CPU)
else()
  openpfc_check_compatibility(RESULT sdk_status REPORT sdk_report REQUIRED BACKEND CPU)
endif()
message(STATUS "${sdk_report}")

# CMake owns compiler/dependency discovery. The CLI never reconstructs link flags.
function(record key value)
  string(SHA256 digest "${value}")
  string(REPLACE "\\" "\\\\" escaped "${value}")
  string(REPLACE "\"" "\\\"" escaped "${escaped}")
  string(REPLACE "\n" "\\n" escaped "${escaped}")
  string(REPLACE "\r" "\\r" escaped "${escaped}")
  string(REPLACE "\t" "\\t" escaped "${escaped}")
  string(TOUPPER "${value}" upper)
  if(upper MATCHES "(TOKEN|PASSWORD|SECRET|CREDENTIAL|API_KEY|ACCESS_KEY|AUTHORIZATION)[A-Z0-9_]*[=:]" OR
      value MATCHES "://[^ /;]*@")
    set(escaped "credential-like diagnostic redacted")
  endif()
  string(JSON metadata SET "${metadata}" "${key}" "{\"value\":\"${escaped}\",\"sha256\":\"${digest}\"}")
  set(metadata "${metadata}" PARENT_SCOPE)
endfunction()
if(OPENPFC_QUERY_REPORT)
  set(metadata "{}")
  if(OPENPFC_DOCTOR)
    record(sdk_status "${sdk_status}")
    record(sdk_report "${sdk_report}")
    record(OpenPFC_DIR "${OpenPFC_DIR}")
  endif()
  file(READ "${OpenPFC_BUILD_MANIFEST}" sdk_manifest)
  string(JSON metadata SET "${metadata}" sdk "${sdk_manifest}")
  string(SHA256 sdk_digest "${sdk_manifest}")
  record(sdk_manifest_sha256 "${sdk_digest}")
  string(TOUPPER "${CMAKE_BUILD_TYPE}" config)
  foreach(name CMAKE_C_COMPILER CMAKE_C_COMPILER_ID CMAKE_C_COMPILER_VERSION
      CMAKE_CXX_COMPILER CMAKE_CXX_COMPILER_ID CMAKE_CXX_COMPILER_VERSION
      CMAKE_CXX_COMPILER_TARGET CMAKE_CXX_COMPILER_ARG1 CMAKE_SYSROOT
      CMAKE_TOOLCHAIN_FILE CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN
      CMAKE_CXX_IMPLICIT_LINK_LIBRARIES CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES
      CMAKE_CXX_COMPILER_LAUNCHER CMAKE_CXX_STANDARD CMAKE_CXX_EXTENSIONS
      CMAKE_BUILD_TYPE CMAKE_C_FLAGS CMAKE_C_FLAGS_${config}
      CMAKE_CXX_FLAGS CMAKE_CXX_FLAGS_${config} CMAKE_EXE_LINKER_FLAGS
      CMAKE_EXE_LINKER_FLAGS_${config} CMAKE_GENERATOR CMAKE_VERSION
      CMAKE_SYSTEM_NAME CMAKE_SYSTEM_PROCESSOR CMAKE_SIZEOF_VOID_P CMAKE_LINKER CMAKE_AR CMAKE_RANLIB
      MPI_CXX_COMPILER MPI_CXX_LIBRARIES MPI_CXX_COMPILE_DEFINITIONS
      MPI_CXX_COMPILE_OPTIONS MPI_CXX_LINK_FLAGS MPIEXEC_EXECUTABLE)
    record("${name}" "${${name}}")
  endforeach()
  foreach(name CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_TOOLCHAIN_FILE CMAKE_LINKER CMAKE_AR CMAKE_RANLIB)
    if(EXISTS "${${name}}")
      file(SHA256 "${${name}}" digest)
      record("${name}_sha256" "${digest}")
    endif()
  endforeach()
  get_target_property(sdk_include_dirs OpenPFC::openpfc INTERFACE_INCLUDE_DIRECTORIES)
  foreach(include_dir IN LISTS sdk_include_dirs)
    if(IS_DIRECTORY "${include_dir}/openpfc")
      file(GLOB_RECURSE headers LIST_DIRECTORIES FALSE "${include_dir}/openpfc/*")
      foreach(header IN LISTS headers)
        file(RELATIVE_PATH name "${include_dir}" "${header}")
        file(SHA256 "${header}" digest)
        record("OpenPFC.header.${name}" "${digest}")
      endforeach()
    endif()
  endforeach()
  set(queue OpenPFC::openpfc)
  set(visited)
  while(queue)
    list(POP_FRONT queue target)
    if(NOT TARGET "${target}" OR target IN_LIST visited)
      continue()
    endif()
    list(APPEND visited "${target}")
    foreach(property INTERFACE_COMPILE_DEFINITIONS INTERFACE_COMPILE_OPTIONS
        INTERFACE_COMPILE_FEATURES INTERFACE_LINK_LIBRARIES INTERFACE_LINK_OPTIONS)
      get_target_property(value "${target}" "${property}")
      record("${target}.${property}" "${value}")
    endforeach()
    get_target_property(location "${target}" "IMPORTED_LOCATION_${config}")
    if(NOT location)
      get_target_property(location "${target}" IMPORTED_LOCATION)
    endif()
    if(NOT location)
      get_target_property(configs "${target}" IMPORTED_CONFIGURATIONS)
      if(configs)
        list(GET configs 0 first)
        get_target_property(location "${target}" "IMPORTED_LOCATION_${first}")
      endif()
    endif()
    if(location AND EXISTS "${location}" AND NOT IS_DIRECTORY "${location}")
      file(SHA256 "${location}" digest)
      record("${target}.artifact_sha256" "${digest}")
      record("${target}.artifact_location" "${location}")
    endif()
    get_target_property(links "${target}" INTERFACE_LINK_LIBRARIES)
    foreach(link IN LISTS links)
      if(link MATCHES "^\\$<LINK_ONLY:([^>]+)>$")
        set(link "${CMAKE_MATCH_1}")
      endif()
      if(TARGET "${link}")
        list(APPEND queue "${link}")
      elseif(IS_ABSOLUTE "${link}" AND EXISTS "${link}" AND NOT IS_DIRECTORY "${link}")
        file(SHA256 "${link}" digest)
        record("${target}.library.${link}" "${digest}")
      endif()
    endforeach()
  endwhile()
  file(WRITE "${OPENPFC_QUERY_REPORT}" "${metadata}\n")
endif()
if(NOT OPENPFC_DISCOVERY_ONLY)
  include(model-files.cmake)
  target_link_libraries(model PRIVATE OpenPFC::openpfc)
  target_include_directories(model PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src")
endif()
